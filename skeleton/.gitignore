# Binary tiers — these live in cloud drive / external storage, NOT git
# (They're usually symlinks on a real machine, but ignore the path either way.)
raw/*
!raw/README.md
archive/

# OS
.DS_Store
Thumbs.db

# Obsidian workspace state (keep plugin settings if you want them versioned)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache


# Scratch space
scratch/
*.tmp

# Whisper / ffmpeg intermediates that might accidentally land in the repo root
*.wav
*.mp4
*.mov
*.webm
*.mkv
*.mp3
__pycache__/

# Claude Code: personal overrides (permissions, env-specific settings)
.claude/settings.local.json
