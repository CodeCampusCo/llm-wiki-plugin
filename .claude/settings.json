{
  "_comment": "Project-level settings — committed to git, shared across machines. Personal overrides go in .claude/settings.local.json (git-ignored).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-context.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-wiki-edit.sh\""
          }
        ]
      }
    ]
  }
}
